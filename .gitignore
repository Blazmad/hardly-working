dist/

# Credential-shaped files: the repo is public, and GitHub push protection only
# recognizes known provider tokens, not generic keys - for .pem/.p12-style
# files this list is the only guard against a stray `git add -A`.
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
